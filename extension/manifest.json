{
  "manifest_version": 3,
  "name": "BES Auto-Fill SUNAT",
  "version": "1.0.1",
  "description": "Autocompleta el RUC, Usuario SOL y Clave SOL en el portal de la SUNAT desde el sistema BES.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.sunat.gob.pe/*",
    "http://*.sunat.gob.pe/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bes.js"]
    },
    {
      "matches": [
        "https://*.sunat.gob.pe/*",
        "http://*.sunat.gob.pe/*"
      ],
      "js": ["content-sunat.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "BES Auto-Fill SUNAT"
  }
}
