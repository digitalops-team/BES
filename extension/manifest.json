{
  "manifest_version": 3,
  "name": "BES Auto-Fill SUNAT",
  "version": "1.0.0",
  "description": "Autocompleta el RUC, Usuario SOL y Clave SOL en el portal de la SUNAT desde el sistema BES.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://e-menu.sunat.gob.pe/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-bes.js"]
    },
    {
      "matches": [
        "https://e-menu.sunat.gob.pe/*"
      ],
      "js": ["content-sunat.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "BES Auto-Fill SUNAT"
  }
}
